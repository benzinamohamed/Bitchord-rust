{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BitChord",
  "version": "0.1.0",
  "identifier": "com.music.bitchord",
  "build": {
    "frontendDist": "../BitChord/web/app/dist"
  },
  "app": {
    "withGlobalTauri": true,
